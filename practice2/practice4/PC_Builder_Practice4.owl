                                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                                                        <swrl:arguments rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="https://example.org/pc-builder#w"/>
                                                                            <rdf:Description rdf:about="https://example.org/pc-builder#required"/>

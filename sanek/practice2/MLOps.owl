<?xml version="1.0"?>
<rdf:RDF xmlns="https://example.org/mlops#"
     xml:base="https://example.org/mlops"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="https://example.org/mlops">
        <owl:versionIRI rdf:resource="https://example.org/mlops/2.0"/>
    </owl:Ontology>

<owl:ObjectProperty rdf:about="https://example.org/mlops#deployedOn">
        <rdfs:subPropertyOf rdf:resource="https://example.org/mlops#requiresAccelerator"/>
        <rdfs:domain rdf:resource="https://example.org/mlops#MLModel"/>
        <rdfs:range rdf:resource="https://example.org/mlops#GPU"/>
    </owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://example.org/mlops#requiresAccelerator">
        <rdfs:domain rdf:resource="https://example.org/mlops#MLModel"/>
        <rdfs:range rdf:resource="https://example.org/mlops#HardwareAccelerator"/>
    </owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="https://example.org/mlops#hasAvailableVRAM">
        <rdfs:domain rdf:resource="https://example.org/mlops#GPU"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://example.org/mlops#hasParameterCountNum">
        <rdfs:domain rdf:resource="https://example.org/mlops#MLModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#long"/>
    </owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://example.org/mlops#hasRequiredVRAM">
        <rdfs:domain rdf:resource="https://example.org/mlops#MLModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

<owl:Class rdf:about="https://example.org/mlops#ComputerVisionModel">
        <rdfs:subClassOf rdf:resource="https://example.org/mlops#MLModel"/>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#GPU">
        <rdfs:subClassOf rdf:resource="https://example.org/mlops#HardwareAccelerator"/>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#HardwareAccelerator"/>

<owl:Class rdf:about="https://example.org/mlops#LargeLanguageModel">
        <rdfs:subClassOf rdf:resource="https://example.org/mlops#MLModel"/>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#MLModel"/>

<owl:NamedIndividual rdf:about="https://example.org/mlops#CV_1B_Detection">
        <rdf:type rdf:resource="https://example.org/mlops#ComputerVisionModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">1</hasParameterCountNum>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#CV_2B_Segmentation">
        <rdf:type rdf:resource="https://example.org/mlops#ComputerVisionModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_16GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_16GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">2</hasParameterCountNum>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#GPU_16GB">
        <rdf:type rdf:resource="https://example.org/mlops#GPU"/>
        <hasAvailableVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</hasAvailableVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#GPU_24GB">
        <rdf:type rdf:resource="https://example.org/mlops#GPU"/>
        <hasAvailableVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</hasAvailableVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#GPU_48GB">
        <rdf:type rdf:resource="https://example.org/mlops#GPU"/>
        <hasAvailableVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">48</hasAvailableVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#GPU_80GB">
        <rdf:type rdf:resource="https://example.org/mlops#GPU"/>
        <hasAvailableVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80</hasAvailableVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#GPU_8GB">
        <rdf:type rdf:resource="https://example.org/mlops#GPU"/>
        <hasAvailableVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</hasAvailableVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_13B_Assistant">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_24GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_48GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">13</hasParameterCountNum>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_1B_Small">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">1</hasParameterCountNum>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_3B_Edge">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">3</hasParameterCountNum>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_70B_Server">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_80GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_80GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">70</hasParameterCountNum>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">142</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_7B_Chat">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_24GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_24GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">7</hasParameterCountNum>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_7B_Limited">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">7</hasParameterCountNum>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</hasRequiredVRAM>
    </owl:NamedIndividual>

<rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
        <owl:distinctMembers rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/mlops#CV_1B_Detection"/>
            <rdf:Description rdf:about="https://example.org/mlops#CV_2B_Segmentation"/>
            <rdf:Description rdf:about="https://example.org/mlops#GPU_16GB"/>
            <rdf:Description rdf:about="https://example.org/mlops#GPU_24GB"/>
            <rdf:Description rdf:about="https://example.org/mlops#GPU_48GB"/>
            <rdf:Description rdf:about="https://example.org/mlops#GPU_80GB"/>
            <rdf:Description rdf:about="https://example.org/mlops#GPU_8GB"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_13B_Assistant"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_1B_Small"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_3B_Edge"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_70B_Server"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_7B_Chat"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_7B_Limited"/>

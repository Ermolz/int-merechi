<?xml version="1.0"?>
<rdf:RDF xmlns="https://example.org/mlops#"
     xml:base="https://example.org/mlops"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="https://example.org/mlops">
        <owl:versionIRI rdf:resource="https://example.org/mlops/3.0"/>
    </owl:Ontology>

<rdfs:Datatype rdf:about="https://example.org/mlops#ModelPrecision">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>FP16</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>INT8</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>

<rdfs:Datatype rdf:about="https://example.org/mlops#PositiveParameterCount">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#long"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>

<rdfs:Datatype rdf:about="https://example.org/mlops#PositiveVRAM">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>

<owl:ObjectProperty rdf:about="https://example.org/mlops#deployedOn">
        <rdfs:subPropertyOf rdf:resource="https://example.org/mlops#requiresAccelerator"/>
        <owl:inverseOf rdf:resource="https://example.org/mlops#hostsModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://example.org/mlops#MLModel"/>
        <rdfs:range rdf:resource="https://example.org/mlops#GPU"/>
    </owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://example.org/mlops#hostsModel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://example.org/mlops#GPU"/>
        <rdfs:range rdf:resource="https://example.org/mlops#MLModel"/>
    </owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://example.org/mlops#isRequiredBy">
        <owl:inverseOf rdf:resource="https://example.org/mlops#requiresAccelerator"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://example.org/mlops#HardwareAccelerator"/>
        <rdfs:range rdf:resource="https://example.org/mlops#MLModel"/>
    </owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://example.org/mlops#requiresAccelerator">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://example.org/mlops#MLModel"/>
        <rdfs:range rdf:resource="https://example.org/mlops#HardwareAccelerator"/>
    </owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="https://example.org/mlops#hasAvailableVRAM">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/mlops#GPU"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:range rdf:resource="https://example.org/mlops#PositiveVRAM"/>
    </owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://example.org/mlops#hasParameterCountNum">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/mlops#MLModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#long"/>
        <rdfs:range rdf:resource="https://example.org/mlops#PositiveParameterCount"/>
    </owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://example.org/mlops#hasPrecision">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/mlops#MLModel"/>
        <rdfs:range rdf:resource="https://example.org/mlops#ModelPrecision"/>
    </owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://example.org/mlops#hasRequiredVRAM">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/mlops#MLModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:range rdf:resource="https://example.org/mlops#PositiveVRAM"/>
    </owl:DatatypeProperty>

<owl:Class rdf:about="https://example.org/mlops#ComputerVisionModel">
        <rdfs:subClassOf rdf:resource="https://example.org/mlops#MLModel"/>
        <owl:disjointWith rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#FP16Model">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/mlops#MLModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/mlops#hasPrecision"/>
                        <owl:hasValue>FP16</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#GPU">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/mlops#GPU_16GB"/>
                    <rdf:Description rdf:about="https://example.org/mlops#GPU_24GB"/>
                    <rdf:Description rdf:about="https://example.org/mlops#GPU_48GB"/>
                    <rdf:Description rdf:about="https://example.org/mlops#GPU_80GB"/>
                    <rdf:Description rdf:about="https://example.org/mlops#GPU_8GB"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://example.org/mlops#HardwareAccelerator"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/mlops#hasAvailableVRAM"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="https://example.org/mlops#PositiveVRAM"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#HardwareAccelerator">
        <owl:disjointWith rdf:resource="https://example.org/mlops#MLModel"/>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#HighMemoryGPU">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/mlops#GPU"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/mlops#hasAvailableVRAM"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">48</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#LargeLanguageModel">
        <rdfs:subClassOf rdf:resource="https://example.org/mlops#MLModel"/>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#LargeMemoryModel">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/mlops#MLModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/mlops#hasRequiredVRAM"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#MLModel">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/mlops#requiresAccelerator"/>
                <owl:someValuesFrom rdf:resource="https://example.org/mlops#HardwareAccelerator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/mlops#deployedOn"/>
                <owl:allValuesFrom rdf:resource="https://example.org/mlops#GPU"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/mlops#requiresAccelerator"/>
                <owl:allValuesFrom rdf:resource="https://example.org/mlops#HardwareAccelerator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/mlops#requiresAccelerator"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://example.org/mlops#HardwareAccelerator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/mlops#deployedOn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://example.org/mlops#GPU"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/mlops#requiresAccelerator"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://example.org/mlops#HardwareAccelerator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/mlops#hasParameterCountNum"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="https://example.org/mlops#PositiveParameterCount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/mlops#hasPrecision"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="https://example.org/mlops#ModelPrecision"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/mlops#hasRequiredVRAM"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="https://example.org/mlops#PositiveVRAM"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#ModelOnGPU24">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/mlops#MLModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/mlops#deployedOn"/>
                        <owl:hasValue rdf:resource="https://example.org/mlops#GPU_24GB"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

<owl:Class rdf:about="https://example.org/mlops#ModelOnHighMemoryGPU">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/mlops#MLModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/mlops#deployedOn"/>
                        <owl:someValuesFrom rdf:resource="https://example.org/mlops#HighMemoryGPU"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

<owl:NamedIndividual rdf:about="https://example.org/mlops#CV_1B_Detection">
        <rdf:type rdf:resource="https://example.org/mlops#ComputerVisionModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">1</hasParameterCountNum>
        <hasPrecision>FP16</hasPrecision>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#CV_2B_Segmentation">
        <rdf:type rdf:resource="https://example.org/mlops#ComputerVisionModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_16GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_16GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">2</hasParameterCountNum>
        <hasPrecision>FP16</hasPrecision>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#GPU_16GB">
        <rdf:type rdf:resource="https://example.org/mlops#GPU"/>
        <hasAvailableVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</hasAvailableVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#GPU_24GB">
        <rdf:type rdf:resource="https://example.org/mlops#GPU"/>
        <hasAvailableVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</hasAvailableVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#GPU_48GB">
        <rdf:type rdf:resource="https://example.org/mlops#GPU"/>
        <hasAvailableVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">48</hasAvailableVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#GPU_80GB">
        <rdf:type rdf:resource="https://example.org/mlops#GPU"/>
        <hasAvailableVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80</hasAvailableVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#GPU_8GB">
        <rdf:type rdf:resource="https://example.org/mlops#GPU"/>
        <hasAvailableVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</hasAvailableVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_13B_Assistant">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_24GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_48GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">13</hasParameterCountNum>
        <hasPrecision>FP16</hasPrecision>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_1B_Small">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">1</hasParameterCountNum>
        <hasPrecision>FP16</hasPrecision>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_3B_Edge">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">3</hasParameterCountNum>
        <hasPrecision>FP16</hasPrecision>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_70B_Server">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_80GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_80GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">70</hasParameterCountNum>
        <hasPrecision>FP16</hasPrecision>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">142</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_7B_Chat">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_24GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_24GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">7</hasParameterCountNum>
        <hasPrecision>FP16</hasPrecision>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</hasRequiredVRAM>
    </owl:NamedIndividual>

<owl:NamedIndividual rdf:about="https://example.org/mlops#LLM_7B_Limited">
        <rdf:type rdf:resource="https://example.org/mlops#LargeLanguageModel"/>
        <deployedOn rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <requiresAccelerator rdf:resource="https://example.org/mlops#GPU_8GB"/>
        <hasParameterCountNum rdf:datatype="http://www.w3.org/2001/XMLSchema#long">7</hasParameterCountNum>
        <hasPrecision>FP16</hasPrecision>
        <hasRequiredVRAM rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</hasRequiredVRAM>
    </owl:NamedIndividual>

<rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
        <owl:distinctMembers rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/mlops#CV_1B_Detection"/>
            <rdf:Description rdf:about="https://example.org/mlops#CV_2B_Segmentation"/>
            <rdf:Description rdf:about="https://example.org/mlops#GPU_16GB"/>
            <rdf:Description rdf:about="https://example.org/mlops#GPU_24GB"/>
            <rdf:Description rdf:about="https://example.org/mlops#GPU_48GB"/>
            <rdf:Description rdf:about="https://example.org/mlops#GPU_80GB"/>
            <rdf:Description rdf:about="https://example.org/mlops#GPU_8GB"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_13B_Assistant"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_1B_Small"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_3B_Edge"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_70B_Server"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_7B_Chat"/>
            <rdf:Description rdf:about="https://example.org/mlops#LLM_7B_Limited"/>
        </owl:distinctMembers>
    </rdf:Description>
</rdf:RDF>

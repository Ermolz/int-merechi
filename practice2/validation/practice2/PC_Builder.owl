<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="https://example.org/pc-builder#" xml:base="https://example.org/pc-builder"
 xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
 xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
 xmlns:owl="http://www.w3.org/2002/07/owl#"
 xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="https://example.org/pc-builder">
    <owl:versionIRI rdf:resource="https://example.org/pc-builder/1.0"/>
  </owl:Ontology>

  <owl:Class rdf:about="#Component">
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasPrice"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/></owl:Restriction></rdfs:subClassOf>
  </owl:Class>

  <owl:Class rdf:about="#CPU">
    <rdfs:subClassOf rdf:resource="#Component"/>
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasSocket"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="#Socket"/></owl:Restriction></rdfs:subClassOf>
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasTDP"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:Restriction></rdfs:subClassOf>
  </owl:Class>

  <owl:Class rdf:about="#Motherboard">
    <rdfs:subClassOf rdf:resource="#Component"/>
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasSocket"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="#Socket"/></owl:Restriction></rdfs:subClassOf>
  </owl:Class>

  <owl:Class rdf:about="#PowerSupply">
    <rdfs:subClassOf rdf:resource="#Component"/>
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasWattage"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:Restriction></rdfs:subClassOf>
  </owl:Class>

  <owl:Class rdf:about="#Socket">
  </owl:Class>

  <owl:Class rdf:about="#PCConfiguration">
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasCPU"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="#CPU"/></owl:Restriction></rdfs:subClassOf>
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasMotherboard"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="#Motherboard"/></owl:Restriction></rdfs:subClassOf>
    <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasPowerSupply"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="#PowerSupply"/></owl:Restriction></rdfs:subClassOf>
  </owl:Class>

  <owl:AllDisjointClasses><owl:members rdf:parseType="Collection"><rdf:Description rdf:about="#Component"/><rdf:Description rdf:about="#Socket"/><rdf:Description rdf:about="#PCConfiguration"/></owl:members></owl:AllDisjointClasses>

  <owl:AllDisjointClasses><owl:members rdf:parseType="Collection"><rdf:Description rdf:about="#CPU"/><rdf:Description rdf:about="#Motherboard"/><rdf:Description rdf:about="#PowerSupply"/></owl:members></owl:AllDisjointClasses>

  <owl:ObjectProperty rdf:about="#hasSocket">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain><owl:Class><owl:unionOf rdf:parseType="Collection"><rdf:Description rdf:about="#CPU"/><rdf:Description rdf:about="#Motherboard"/></owl:unionOf></owl:Class></rdfs:domain>
    <rdfs:range rdf:resource="#Socket"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasCPU">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#PCConfiguration"/>
    <rdfs:range rdf:resource="#CPU"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasMotherboard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#PCConfiguration"/>
    <rdfs:range rdf:resource="#Motherboard"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasPowerSupply">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#PCConfiguration"/>
    <rdfs:range rdf:resource="#PowerSupply"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="#hasTDP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#CPU"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasWattage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#PowerSupply"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasPrice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Component"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:NamedIndividual rdf:about="#Socket_AM4">
    <rdf:type rdf:resource="#Socket"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#Socket_AM5">
    <rdf:type rdf:resource="#Socket"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#Socket_LGA1700">
    <rdf:type rdf:resource="#Socket"/>
  </owl:NamedIndividual>


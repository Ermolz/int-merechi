  <owl:NamedIndividual rdf:about="#Motherboard_LGA1700">
    <rdf:type rdf:resource="#Motherboard"/>
    <hasSocket rdf:resource="#Socket_LGA1700"/>
    <hasPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">160.00</hasPrice>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#PSU_450W">
    <rdf:type rdf:resource="#PowerSupply"/>
    <hasWattage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">450</hasWattage>
    <hasPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50.00</hasPrice>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#PSU_650W">
    <rdf:type rdf:resource="#PowerSupply"/>
    <hasWattage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">650</hasWattage>
    <hasPrice rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">80.00</hasPrice>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#PSU_750W">
    <rdf:type rdf:resource="#PowerSupply"/>
    <hasWattage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">750</hasWattage>
